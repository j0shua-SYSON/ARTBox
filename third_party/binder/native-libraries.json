      "generated_aidl": true
    },
    "libutils_binder": {
      "source": "binder-utils",
      "units": [
        "libutils/binder/Errors.cpp",
        "libutils/binder/RefBase.cpp",
        "libutils/binder/SharedBuffer.cpp",
        "libutils/binder/String16.cpp",
        "libutils/binder/String8.cpp",
        "libutils/binder/StrongPointer.cpp",
        "libutils/binder/Unicode.cpp",
