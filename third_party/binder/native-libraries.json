    "binder-system": [
      "libcutils/include",
      "libprocessgroup/include",
      "libvndksupport/include",
      "libsystem/include",
      "libvendorsupport/include_llndk"
    ],
    "binder-apex-headers": [
      "libs/libapexsupport/include"
    ],
    "libbase-dex": [
      "include"
    ],
    "liblog-dex": [
      "liblog/include"
    ]
  }
}
